# ==============================================================================
# Quran Baanto - Environment Configuration & Secret Placeholders
# ==============================================================================
# For local builds: copy this file to .env and replace placeholders with your credentials.
# For GitHub Actions: add corresponding secrets in GitHub Repo Settings -> Secrets & Variables.
# For Google Play release: ensure official AdMob App ID & Ad Unit IDs are supplied.

# --- Firebase / Firestore Cloud Configuration ---
# Found in Firebase Console -> Project Settings -> General -> Your apps (Android)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890abcdef
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
FIREBASE_API_KEY=AIzaSyPlaceholderKeyForQuranBaantoApp123

# --- Google AdMob Configuration ---
# Google AdMob Test IDs are pre-filled below so builds, testing, and CI will NEVER crash or trigger policy strikes.
# When publishing to the Google Play Store, replace these with your production AdMob credentials:
# 1. ADMOB_APP_ID: From Google AdMob Console -> Apps -> App Settings (e.g. ca-app-pub-XXXXXXXXXXXX~YYYYYYYYYY)
# 2. ADMOB_REWARDED_AD_UNIT_ID: From AdMob Console -> Ad Units -> Rewarded Video (e.g. ca-app-pub-XXXXXXXXXXXX/ZZZZZZZZZZ)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# --- Keystore & Signing Configuration (for manual release builds) ---
# In GitHub Actions, provide these as GitHub repository secrets:
# KEYSTORE_BASE64: Base64-encoded release .jks or .keystore file
# STORE_PASSWORD: Password for the keystore
# KEY_ALIAS: Key alias (default: upload)
# KEY_PASSWORD: Password for the key
KEY_ALIAS=upload
